# Fuzz harness targets (see fuzz_inject.cmake). Each harness is linked twice: with libFuzzer
# (<name>) and with the base image's run-once driver (<name>-standalone, OLIVE_FUZZ_STANDALONE_OBJ).
set(_h "${CMAKE_CURRENT_LIST_DIR}/harnesses")

function(olive_fuzz_pair name)
  cmake_parse_arguments(A "APP" "" "SOURCES" ${ARGN})
  foreach(kind fuzz standalone)
    if(kind STREQUAL "fuzz")
      set(t ${name})
    else()
      set(t ${name}-standalone)
    endif()
    if(A_APP)
      add_executable(${t} ${A_SOURCES} $<TARGET_OBJECTS:libolive-editor>)
      target_include_directories(${t} PRIVATE ${CMAKE_SOURCE_DIR}/app ${_h} ${OLIVE_INCLUDE_DIRS})
      target_link_libraries(${t} PRIVATE ${OLIVE_LIBRARIES})
      target_compile_definitions(${t} PRIVATE ${OLIVE_DEFINITIONS})
      target_compile_options(${t} PRIVATE ${OLIVE_COMPILE_OPTIONS})
    else()
      add_executable(${t} ${A_SOURCES})
      target_include_directories(${t} PRIVATE ${CMAKE_SOURCE_DIR}/ext/core/include)
      target_link_libraries(${t} PRIVATE olivecore)
    endif()
    # mayhem/lsan_off.cc, compiled by build.sh with the sanitizer flags
    target_link_libraries(${t} PRIVATE "${OLIVE_FUZZ_LSAN_OBJ}")
    if(kind STREQUAL "fuzz")
      target_link_options(${t} PRIVATE -fsanitize=fuzzer)
    else()
      target_link_libraries(${t} PRIVATE "${OLIVE_FUZZ_STANDALONE_OBJ}")
    endif()
    set_target_properties(${t} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/fuzz")
  endforeach()
endfunction()

olive_fuzz_pair(fuzz_project_load APP SOURCES ${_h}/fuzz_project_load.cpp)
olive_fuzz_pair(fuzz_paste APP SOURCES ${_h}/fuzz_paste.cpp)
olive_fuzz_pair(fuzz_html APP SOURCES ${_h}/fuzz_html.cpp)
olive_fuzz_pair(fuzz_timecode SOURCES ${_h}/fuzz_timecode.cpp)
